# Plantilla de secretos locales. Cópiala a `.env.scripts` (ignorado por git; Next.js no lo lee, así que no llega a la web
# ni al despliegue) y rellena solo lo que uses. Nunca pongas valores reales en este archivo.

# npm run models:fetch — descargar de Sketchfab (buscar no lo pide). Sketchfab → Settings → Password & API → API token
SKETCHFAB_TOKEN=

# npm run models:fetch — buscar y bajar de Poly Pizza. https://poly.pizza/settings/api
POLY_PIZZA_KEY=
