{
  "name": "trama-ui",
  "version": "0.1.0",
  "description": "Trama: librería de componentes React/Next.js (ASCII, textmode, pixel art, secciones de landing). Ver docs/README.md y AGENTS.md.",
  "license": "MIT",
  "author": "Daniel Martínez Sebastián",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielMartinezSebastian/trama.git"
  },
  "homepage": "https://github.com/DanielMartinezSebastian/trama#readme",
  "bugs": {
    "url": "https://github.com/DanielMartinezSebastian/trama/issues"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "catalog": "tsx --import ./scripts/stub-register.mjs scripts/build-catalog.mts",
    "catalog:check": "tsx --import ./scripts/stub-register.mjs scripts/build-catalog.mts --check",
    "kit:export": "tsx scripts/kit-export.mts",
    "kit:pull": "tsx scripts/kit-pull.mts",
    "pkg:build": "tsx scripts/build-package.mts",
    "pkg:pack": "tsx scripts/build-package.mts && cd dist-npm && npm pack"
  },
  "dependencies": {
    "asciify-engine": "^4.1.0",
    "gsap": "^3.15.0",
    "next": "^16.3.5",
    "pixelarticons": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "swiper": "^14.2.0",
    "textmode.js": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
