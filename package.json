{
  "name": "trama-ui",
  "version": "0.13.0",
  "description": "Trama: componentes, guías visuales y recetas para construir webs con carácter en React y Next.js; skills experimentales para agentes.",
  "license": "MIT",
  "author": "Daniel Martínez Sebastián",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielMartinezSebastian/trama.git"
  },
  "homepage": "https://github.com/DanielMartinezSebastian/trama#readme",
  "bugs": {
    "url": "https://github.com/DanielMartinezSebastian/trama/issues"
  },
  "private": true,
  "scripts": {
    "doctor": "tsx scripts/doctor.mts",
    "verify": "npm run typecheck && npm run catalog:check && npm run agents:test && npm run check:shadows && npm run cine:test && npm run lab:cuaderno -- --check",
    "smoke": "tsx scripts/smoke.mts",
    "cine:test": "tsx scripts/cine/base-url.test.mts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "catalog": "tsx --import ./scripts/stub-register.mjs scripts/build-catalog.mts",
    "images:fetch": "tsx scripts/fetch-images.mts",
    "videos:fetch": "tsx scripts/fetch-videos.mts",
    "models:fetch": "tsx scripts/fetch-models.mts",
    "check:shadows": "tsx scripts/check-text-shadow.mts",
    "catalog:check": "tsx --import ./scripts/stub-register.mjs scripts/build-catalog.mts --check",
    "kit:export": "tsx scripts/kit-export.mts",
    "kit:pull": "tsx scripts/kit-pull.mts",
    "pkg:build": "tsx scripts/build-package.mts",
    "pkg:pack": "tsx scripts/build-package.mts && cd dist-npm && npm pack",
    "refs:probe": "tsx scripts/probe-refs.mts",
    "cine:capture": "tsx scripts/cine/capture.mts",
    "cine:analyze": "tsx scripts/cine/analyze.mts",
    "cine:compare": "tsx scripts/cine/compare.mts",
    "cine:conjunto": "tsx scripts/cine/conjunto.mts",
    "cine:tramo": "tsx scripts/cine/tramo.mts",
    "cine:explora": "tsx scripts/cine/explora.mts",
    "cine:sonda": "tsx scripts/cine/sonda.mts",
    "cine:vuelta": "tsx scripts/cine/vuelta.mts",
    "cine:flujo": "tsx scripts/cine/flujo.mts",
    "cine:reestudio": "tsx scripts/cine/reestudio.mts",
    "cine:web": "tsx scripts/cine/web.mts",
    "cine:sintesis": "tsx scripts/cine/sintesis.mts",
    "cine:rampa": "tsx scripts/cine/rampa.mts",
    "cine:ritmo": "tsx scripts/cine/ritmo.mts",
    "lab:cuaderno": "tsx scripts/cuaderno.mts",
    "agents:check-package": "tsx scripts/check-agent-package.mts",
    "agents:test": "tsx --import ./scripts/stub-register.mjs scripts/agent-knowledge.test.mts",
    "agents:pilot": "tsx scripts/prepare-agent-pilot.mts",
    "agents:test-install": "tsx scripts/test-agent-install.mts",
    "agents:test-pilot": "tsx scripts/test-agent-pilot.mts",
    "agents:evaluate": "tsx scripts/evaluate-agents.mts",
    "agents:validate-evaluation": "tsx scripts/validate-agent-evaluation.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "asciify-engine": "^4.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "next": "^16.3.5",
    "pixelarticons": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "swiper": "^14.2.0",
    "textmode.js": "^0.18.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.9",
    "gltfjsx": "^6.5.3",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
