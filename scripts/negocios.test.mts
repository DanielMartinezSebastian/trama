/** End-to-end business flows in isolated browser contexts. Run against a local dev or production server. */
import assert from "node:assert/strict";
import { mkdirSync, writeFileSync } from "node:fs";
import { chromium } from "playwright";
import { chromiumPath } from "./chromium-path.mts";

const base = new URL(process.argv[2] ?? "http://localhost:3000");
assert(["localhost", "127.0.0.1", "[::1]"].includes(base.hostname), "Solo servidores locales");
const out = ".refs3d/negocios";
mkdirSync(out, { recursive: true });
const browser = await chromium.launch({ executablePath: chromiumPath() });
const errors: string[] = [];
const checks: string[] = [];
try {
  const context = await browser.newContext({ viewport: { width: 1440, height: 960 }, reducedMotion: "reduce", acceptDownloads: true });
  const page = await context.newPage();
  page.on("pageerror", e => errors.push(e.message));
  page.on("console", m => { if (m.type() === "error") errors.push(m.text()); });
  const go = async (p: string) => { const r = await page.goto(new URL(p,base).href, { waitUntil: "networkidle" }); assert.equal(r?.status(),200,p); };
  const savedSalon = () => page.evaluate(() => JSON.parse(localStorage.getItem("trama-hebra-v1") ?? "[]") as { id: string; date: string; time: string; name: string }[]);
  await go("/sitios/hebra");
  await page.getByRole("button", { name: "Textura", exact: true }).click();
  assert.match(await page.locator(".hb-look-detail").innerText(), /rizos/);
  await page.getByRole("button", { name: "Color", exact: true }).click();
  assert.match(await page.locator(".hb-look-detail").innerText(), /luz/);
  checks.push("Hebra: el índice editorial conecta intención, servicio y reserva");
  await go("/sitios/hebra/reservar?servicio=rizo&profesional=Alba");
  assert.match(await page.locator(".hb-summary").innerText(), /Rizo a rizo/);
  await page.getByRole("button", { name: "Elegir día y hora" }).click();
  await page.locator(".ui-date__quick button").nth(3).click();
  await page.locator('input[type="radio"]:not(:disabled)').first().check({ force: true });
  await page.getByRole("button", { name: "Continuar con mis datos" }).click();
  await page.getByLabel("Tu nombre", { exact: true }).fill("Alex Demo");
  await page.getByLabel("Correo (solo para probar el formulario)").fill("demo@example.com");
  await page.locator('input[type="checkbox"]').check();
  await page.getByRole("button", { name: "Confirmar cita de prueba" }).click();
  await page.waitForURL("**/mis-citas?confirmada=1");
  await page.getByRole("status").filter({hasText: "Cita de prueba guardada"}).waitFor();
  const first = (await savedSalon())[0];
  assert.equal(first.name,"Alex Demo");
  await page.reload({ waitUntil: "networkidle" });
  assert.match(await page.locator(".hb-appointments").innerText(), /Alex Demo/);
  assert(!(await page.evaluate(() => localStorage.getItem("trama-hebra-v1")))?.includes("demo@example.com"));
  const download = page.waitForEvent("download");
  await page.getByRole("button", { name: "Añadir al calendario" }).click();
  assert.equal((await download).suggestedFilename(),"reserva-demo.ics");
  checks.push("Hebra: reserva completa, persistencia tras recarga, correo descartado y calendario descargable");
  await page.getByRole("link", { name: "Reprogramar", exact: true }).click();
  await page.getByRole("button", { name: "Elegir día y hora" }).click();
  await page.locator(".ui-date__quick button").nth(2).click();
  await page.locator('input[type="radio"]:not(:disabled)').first().check({ force: true });
  await page.getByRole("button", { name: "Continuar con mis datos" }).click();
  await page.getByLabel("Correo (solo para probar el formulario)").fill("demo@example.com");
  await page.locator('input[type="checkbox"]').check();
  await page.getByRole("button", { name: "Guardar cambio de cita" }).click();
  await page.waitForURL("**/mis-citas?confirmada=1");
  await page.locator(".hb-appointments").waitFor();
  const changed = await savedSalon();
  assert.equal(changed.length,1); assert.equal(changed[0].id,first.id); assert.notEqual(changed[0].date,first.date);
  await page.getByRole("button", { name: "Cancelar cita", exact: true }).click();
  await page.getByRole("button", { name: "Conservar cita", exact: true }).click();
  assert.equal((await savedSalon()).length,1);
  await page.getByRole("button", { name: "Cancelar cita", exact: true }).click();
  await page.getByRole("button", { name: "Confirmar cancelación", exact: true }).click();
  await page.locator(".hb-empty").waitFor();
  assert.equal((await savedSalon()).length,0);
  checks.push("Hebra: reprogramar conserva la identidad; cancelar exige confirmación y libera la agenda");
  await go("/sitios/cadencia/clases");
  await page.locator(".cd-days button").first().waitFor();
  // Choose the first weekday so all disciplines have sessions.
  const dayIndex = await page.locator(".cd-days button").evaluateAll(nodes => nodes.findIndex(n => !/sáb|dom/i.test(n.textContent ?? "")));
  await page.locator(".cd-days button").nth(dayIndex).click();
  const row = page.locator(".cd-schedule article").filter({ hasText: "Fuerza base" });
  await row.getByRole("button", { name: "Reservar plaza", exact: true }).click();
  await page.getByRole("dialog").waitFor();
  await page.keyboard.press("Tab");
  assert(await page.evaluate(() => !!document.activeElement?.closest('[role="dialog"]')));
  await page.getByRole("dialog").getByLabel("Correo para probar tu reserva").fill("demo@example.com");
  await page.getByRole("dialog").locator('input[type="checkbox"]').check();
  await page.getByRole("button", { name: "Confirmar plaza de prueba" }).click();
  await row.getByRole("link", { name: "Ver mi reserva" }).waitFor();
  const full = page.locator(".cd-schedule article").filter({ hasText: "Engine club" });
  await full.getByRole("button", { name: "Entrar en espera" }).click();
  await page.getByRole("dialog").getByLabel("Correo para probar tu reserva").fill("demo@example.com");
  await page.getByRole("dialog").locator('input[type="checkbox"]').check();
  await page.getByRole("button", { name: "Apuntarme a la espera de prueba" }).click();
  await full.getByRole("link", { name: "Ver mi reserva" }).waitFor();
  await page.getByRole("button", { name: "Movilidad", exact: true }).click();
  assert(!(await page.locator(".cd-schedule").innerText()).includes("Fuerza base"));
  checks.push("Cadencia: reserva, foco en diálogo, control de duplicados, lista de espera y filtros");
  await go("/sitios/cadencia/planes");
  await page.getByRole("button", { name: "Elegir este plan" }).nth(1).click();
  await page.getByRole("button", { name: "Activar plan de prueba" }).click();
  await go("/sitios/cadencia/mi-ritmo");
  assert.match(await page.locator(".cd-member-plan").innerText(), /CLUB/i);
  assert.equal(await page.locator(".cd-bookings article").count(),2);
  await page.getByLabel("Mi objetivo", { exact: true }).selectOption("Ganar fuerza");
  await page.reload({ waitUntil: "networkidle" });
  assert.equal(await page.getByLabel("Mi objetivo", { exact: true }).inputValue(),"Ganar fuerza");
  assert.equal(await page.locator(".cd-bookings article").count(),2);
  assert(!(await page.evaluate(() => localStorage.getItem("trama-cadencia-v1")))?.includes("demo@example.com"));
  await page.getByRole("button", { name: "Cancelar plaza", exact: true }).click();
  await page.getByRole("button", { name: "Confirmar cancelación", exact: true }).click();
  await page.getByRole("button", { name: "Salir de la espera", exact: true }).click();
  await page.getByRole("button", { name: "Confirmar cancelación", exact: true }).click();
  await page.getByRole("button", { name: "Dar de baja el plan", exact: true }).click();
  await page.getByRole("button", { name: "Confirmar baja del plan", exact: true }).click();
  await page.getByRole("link", { name: "Comparar planes", exact: true }).waitFor();
  assert.equal(await page.locator(".cd-bookings article").count(),0);
  checks.push("Cadencia: activar y dar de baja plan, persistir objetivo y reservas, cancelar plaza y espera");

  for (const width of [1440,390]) {
    await page.setViewportSize({ width, height: width === 390 ? 844 : 960 });
    for (const [slug,paths] of [["hebra",["","servicios","equipo","reservar","mis-citas"]],["cadencia",["","clases","planes","club","mi-ritmo"]]] as const) {
      for (const path of paths) {
        await go(`/sitios/${slug}${path ? `/${path}` : ""}`);
        assert.equal(await page.locator("main h1").count(),1,`Un h1 en ${slug}/${path}`);
        assert(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1),`Sin desbordamiento en ${slug}/${path} a ${width}px`);
        await page.locator("img").evaluateAll(imgs => imgs.forEach(i => { if(i instanceof HTMLImageElement) i.loading = "eager"; }));
        await page.waitForFunction(() => Array.from(document.images).every(i => i.complete));
        assert.equal(await page.locator("img").evaluateAll(imgs => imgs.filter(i => i instanceof HTMLImageElement && (!i.complete || i.naturalWidth === 0)).length),0,`Imágenes en ${slug}/${path}`);
        await page.screenshot({ path: `${out}/${slug}-${path || "inicio"}-${width}.png`, fullPage: true });
      }
    }
  }
  checks.push("Diez rutas a 1440 y 390 px: HTTP 200, un h1, imágenes cargadas y sin desbordamiento");
  const corrupt = await browser.newContext();
  await corrupt.addInitScript(() => { localStorage.setItem("trama-hebra-v1",'{"bad":true}'); localStorage.setItem("trama-cadencia-v1",'{"plan":"Desconocido"}'); });
  const cp = await corrupt.newPage(); cp.on("pageerror",e => errors.push(e.message));
  await cp.goto(new URL("/sitios/hebra/mis-citas",base).href,{waitUntil:"networkidle"});
  await cp.locator(".hb-empty").waitFor();
  await cp.goto(new URL("/sitios/cadencia/mi-ritmo",base).href,{waitUntil:"networkidle"});
  await cp.getByRole("link",{name:"Comparar planes",exact:true}).waitFor();
  await corrupt.close();
  checks.push("Almacenamiento inválido ignorado sin romper ninguna demo");
  assert.deepEqual(errors,[],"Sin errores de consola ni excepciones");
  writeFileSync(`${out}/recorridos.json`,JSON.stringify({ base:base.href,checks,errors },null,2));
  console.log(checks.map(c => `✓ ${c}`).join("\n"));
} finally { await browser.close(); }
